<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>px4_direct_actuator_test</name>
  <version>0.0.1</version>
  <description>Standalone test node that drives PX4 direct_actuator offboard control over uXRCE-DDS for Isaac Sim / Pegasus HIL.</description>
  <maintainer email="pieperkeilan@gmail.com">Keilan Pieper</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>px4_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
