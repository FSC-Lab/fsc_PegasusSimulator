<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>px4_vtol_direct_actuator</name>
  <version>0.0.1</version>
  <description>VTOL flight controllers for the FSC tilt-quadplane: geometric hover, SMC outer loop and the NMPC family (cascade, 6-state longitudinal, 19-state full-state), driving PX4 via direct-actuator offboard. Simulator-independent -- validated in HIL but with no dependency on Isaac Sim or Pegasus.</description>
  <maintainer email="pieperkeilan@gmail.com">Keilan Pieper</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <!-- Mocap and PositionControllerReference: 17 imports across the controllers.
       This was undeclared, so the package could not build on a clean machine. -->
  <exec_depend>fsc_autopilot_ros2_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
