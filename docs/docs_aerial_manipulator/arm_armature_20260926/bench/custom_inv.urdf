    </gpio>
    <gpio name="dxl4">
      <param name="type">dxl</param>
      <param name="ID">14</param>
      <param name="Torque Enable">1</param>
      <param name="Min Position Limit">683</param>
      <param name="Max Position Limit">3413</param>
      <command_interface name="Goal Position"/>
      <param name="Operating Mode">3</param>
      <param name="PWM Limit">885</param>
      <state_interface name="Present Position"/>
      <state_interface name="Present Velocity"/>
      <state_interface name="Present Current"/>
      <state_interface name="Torque Enable"/>
      <state_interface name="Present Input Voltage"/>
      <param name="Position P Gain">800</param>
      <param name="Position I Gain">100</param>
      <param name="Position D Gain">100</param>
      <param name="Profile Velocity">200</param>
      <param name="Profile Acceleration">50</param>
      <param name="Drive Mode">0</param>
      <param name="Return Delay Time">0</param>
    </gpio>
    <gpio name="dxl5">
      <param name="type">dxl</param>
      <param name="ID">15</param>
      <param name="Torque Enable">1</param>
      <command_interface name="Goal Position"/>
      <state_interface name="Present Position"/>
      <state_interface name="Present Velocity"/>
      <state_interface name="Present Current"/>
      <state_interface name="Torque Enable"/>
      <state_interface name="Present Input Voltage"/>
      <!-- Current based Position Control, NOT plain Position mode. Set
             unconditionally so the gripper keeps its current cap whatever mode
             joints 1-4 are in. See the gripper_goal_current arg above.
             Keep colon-space out of comments inside a macro - they survive into
             the generated URDF, and a launch file that hands robot_description
             to a Node as a plain dict runs that string through a YAML parser,
             which then reads the colon as a mapping and aborts the launch. -->
      <param name="Operating Mode">5</param>
      <param name="Goal Current">200</param>
      <param name="Return Delay Time">0</param>
    </gpio>
  </ros2_control>
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>/home/shiqi/ros2_ws/install/open_manipulator_x_bringup/share/open_manipulator_x_bringup/config/gazebo_controller_manager.yaml</parameters>
    </plugin>
  </gazebo>
  <!-- World -->
  <link name="world"/>
  <joint name="world_fixed" type="fixed">
    <origin rpy="3.141592653589793 0 0" xyz="0 0 0.0"/>
    <parent link="world"/>
    <child link="link1"/>
  </joint>
</robot>
